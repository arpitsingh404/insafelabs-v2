# Copy to backend/.env and fill in real values. Never commit the real .env.

# --- Database ---
MONGO_URL="mongodb://localhost:27017"
DB_NAME="insafelabs"

# --- Auth (REQUIRED) ---
# Use a long random string for JWT_SECRET, and a strong access code (not a 6-digit PIN).
JWT_SECRET="change-me-to-a-long-random-64-char-string"
ADMIN_PASSWORD="change-me-to-a-strong-access-code"

# --- Flask/FastAPI front-end origin (CORS) ---
FRONTEND_URL="http://localhost:3000"

# --- AI backend: DeepSeek via its Anthropic-compatible endpoint ---
LLM_BACKEND="gateway"
LLM_API_KEY="sk-..."
LLM_BASE_URL="https://api.deepseek.com/anthropic"
LLM_MODEL="deepseek-chat"

# --- Optional integrations ---
# IMEI_INFO_API_KEY=""
# VISION_API_KEY=""
# TRUST_PROXY=1                 # only if behind a trusted reverse proxy

# --- SSRF guard: allow scanning internal/private targets (default: blocked) ---
# ALLOW_PRIVATE_TARGETS=1

# --- Arsenal tool detection: extra bin dirs to scan (pathsep-separated) ---
# ARSENAL_EXTRA_BIN_DIRS="C:\InsafeLabs\tools-venv\Scripts;C:\Program Files (x86)\Nmap"
